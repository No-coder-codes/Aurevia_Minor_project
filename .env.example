# NexusFlow College Operations & Academic Management SaaS
# Environment Variables Configuration Template

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-secure-random-50-character-secret-key-here
ALLOWED_HOSTS=nexusflow.yourcampus.edu,localhost,127.0.0.1

# Database Configuration (PostgreSQL recommended for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nexusflow_db
DB_USER=nexusflow_admin
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
# Comma-separated list of allowed origins (leave unset in development for auto-allow)
CORS_ALLOWED_ORIGINS=https://nexusflow.yourcampus.edu

# Security & SSL
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# Static & Media Asset Storage
# Defaults: BASE_DIR / 'staticfiles' and BASE_DIR / 'media'
